<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playback_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">
    <ImageView
        android:id="@+id/blur_background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/image_slideshow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:visibility="gone"
        android:scrollbars="none" />
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:controller_layout_id="@layout/empty_media_controller" />
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
    <TextView
        android:id="@+id/text_content_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:padding="32dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/sidebar_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#111111"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToPadding="true" />
    <com.google.android.material.button.MaterialButton android:maxLines="6"
        android:id="@+id/trial_expired_badge"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="@dimen/app_spacing_medium"
        android:backgroundTint="#CC7A1F1F"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="48dp"
        android:minWidth="0dp"
        android:text="@string/trial_expired_badge"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ui_text_caption"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="@dimen/ui_corner_radius" />
    <ScrollView
        android:id="@+id/pairing_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pairing_background"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/pairing_content_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_margin="0dp"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:id="@+id/pairing_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@mipmap/ic_launcher" />
                    <TextView
                        android:id="@+id/pairing_device_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/pairing_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/open_help_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:maxLines="3"
                        android:text="@string/pairing_connection_help"
                        android:textSize="12sp"
                        android:textColor="@color/pairing_text_secondary" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/close_pairing_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:maxLines="3"
                        android:text="@string/exit_app"
                        android:textSize="12sp"
                        android:textColor="@color/pairing_text_secondary" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/pairing_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">
                    <LinearLayout
                        android:id="@+id/pairing_qr_section"
                        android:layout_width="144dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <FrameLayout
                            android:id="@+id/pairing_qr_frame"
                            android:layout_width="144dp"
                            android:layout_height="144dp"
                            android:background="@drawable/bg_pairing_qr_surface"
                            android:padding="8dp">
                            <ImageView
                                android:id="@+id/pairing_qr_code"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/pairing_qr_background"
                                android:contentDescription="@string/pairing_qr_content_description"
                                android:scaleType="fitCenter" />
                            <TextView
                                android:id="@+id/pairing_qr_unavailable"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:padding="8dp"
                                android:text="@string/pairing_network_hint"
                                android:textColor="@color/pairing_qr_ink"
                                android:textSize="12sp"
                                android:visibility="gone" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/pairing_qr_caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/pairing_scan_phone"
                            android:textColor="@color/pairing_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/pairing_details"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="32dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/pairing_connect_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pairing_connect_title"
                            android:textColor="@color/pairing_text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/pairing_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/pairing_connection_summary"
                            android:textColor="@color/pairing_text_secondary"
                            android:textSize="12sp" />
                        <LinearLayout
                            android:id="@+id/pairing_credentials"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:id="@+id/pairing_address_group"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="16dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/control_address"
                                    android:textColor="@color/pairing_text_muted"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/pairing_address"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/pairing_text_primary"
                                    android:textIsSelectable="true"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/pairing_code_group"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/pairing_access_code_label"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/pairing_computer_code"
                                    android:textColor="@color/pairing_text_muted"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/pairing_access_code"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:contentDescription="@string/pairing_computer_code_content_description"
                                    android:fontFamily="monospace"
                                    android:textColor="@color/pairing_text_primary"
                                    android:textIsSelectable="true"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/pairing_network_actions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/pairing_network_status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:accessibilityLiveRegion="polite"
                                android:text="@string/pairing_network_connected"
                                android:textColor="@color/pairing_accent"
                                android:textSize="12sp" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/open_hotspot_settings_button"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:minWidth="48dp"
                                android:maxLines="3"
                                android:text="@string/pairing_network_action"
                                android:textColor="@color/pairing_accent"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/pairing_hotspot_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:textColor="@color/pairing_text_secondary"
                            android:textIsSelectable="true"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/pairing_secondary_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/open_billing_row"
                        android:layout_width="420dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="@drawable/bg_entitlement_upgrade"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp">
                        <ImageView
                            android:id="@+id/entitlement_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_pro_crown_24"
                            android:contentDescription="@null"
                            app:tint="@color/pairing_pro_gold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:orientation="vertical"
                            app:layout_constraintStart_toEndOf="@id/entitlement_icon"
                            app:layout_constraintEnd_toStartOf="@id/entitlement_upgrade_hint"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/pro_badge_label"
                                android:text="@string/pairing_pro_badge"
                                android:textColor="@android:color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/entitlement_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:importantForAccessibility="no"
                                android:textColor="@android:color/white"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/entitlement_upgrade_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:minWidth="112dp"
                            android:background="@drawable/bg_pairing_plan_button"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="@string/pairing_pro_action"
                            android:textColor="@color/pairing_brand_blue"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/enterprise_contact_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/enterprise_contact_title"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/playback_status_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/app_spacing_medium"
        android:background="@drawable/bg_playback_controls"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/app_spacing_small"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:maxLines="6"
            android:id="@+id/show_pairing_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="@string/show_pairing"
            android:textColor="@android:color/white" />
        <com.google.android.material.button.MaterialButton android:maxLines="6"
            android:id="@+id/pause_resume_button"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/resume"
            android:minWidth="0dp"
            android:text=""
            app:icon="@android:drawable/ic_media_play"
            app:iconTint="@android:color/white" />
    </LinearLayout>
</FrameLayout>
