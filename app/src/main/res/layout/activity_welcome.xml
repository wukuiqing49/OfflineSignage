<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/welcome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/welcome_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:minHeight="640dp"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="56dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_welcome_label"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/welcome_label"
            android:textColor="@color/welcome_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/welcome_title"
            android:textColor="@color/welcome_text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxLines="4"
            android:text="@string/welcome_summary"
            android:textColor="@color/welcome_text_secondary"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.LocalSignage.WelcomeStep"
                android:text="@string/welcome_step_network" />

            <TextView
                style="@style/TextAppearance.LocalSignage.WelcomeStep"
                android:layout_marginTop="12dp"
                android:text="@string/welcome_step_pair" />

            <TextView
                style="@style/TextAppearance.LocalSignage.WelcomeStep"
                android:layout_marginTop="12dp"
                android:text="@string/welcome_step_play" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/start_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:text="@string/welcome_start"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/welcome_offline_note"
            android:textColor="@color/welcome_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
