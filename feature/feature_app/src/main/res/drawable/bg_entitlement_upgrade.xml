<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#1948B4" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#2563EB" /><stroke android:width="2dp" android:color="#FFFFFF" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#2563EB" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
