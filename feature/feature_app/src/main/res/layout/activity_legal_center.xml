<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/legal_center_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/billing_background" android:orientation="vertical">
    <FrameLayout android:id="@+id/toolbar_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/billing_background">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" app:navigationIcon="@drawable/ic_arrow_back_24" app:title="@string/legal_center_title" app:titleTextColor="@color/billing_text_primary" />
    </FrameLayout>
    <ScrollView android:id="@+id/legal_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true" android:scrollbars="none">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="8dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintWidth_max="@dimen/billing_content_max_width">
                <TextView android:lineSpacingExtra="5dp" android:breakStrategy="high_quality" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/legal_center_intro" android:textColor="@color/billing_text_secondary" android:textSize="14sp" android:layout_marginBottom="12dp" />
                <LinearLayout android:id="@+id/legal_groups" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <com.google.android.material.button.MaterialButton android:maxLines="6" android:id="@+id/privacy_button" style="@style/Widget.LocalSignage.TopicButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="start|center_vertical" android:text="@string/legal_privacy_title" app:cornerRadius="@dimen/ui_corner_radius" app:icon="@drawable/ic_chevron_right_24" app:iconGravity="textEnd" android:minHeight="48dp" />
                        <com.google.android.material.button.MaterialButton android:maxLines="6" android:id="@+id/terms_button" style="@style/Widget.LocalSignage.TopicButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="start|center_vertical" android:text="@string/legal_terms_title" app:cornerRadius="@dimen/ui_corner_radius" app:icon="@drawable/ic_chevron_right_24" app:iconGravity="textEnd" android:minHeight="48dp" />
                        <com.google.android.material.button.MaterialButton android:maxLines="6" android:id="@+id/subscription_button" style="@style/Widget.LocalSignage.TopicButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="start|center_vertical" android:text="@string/legal_subscription_title" app:cornerRadius="@dimen/ui_corner_radius" app:icon="@drawable/ic_chevron_right_24" app:iconGravity="textEnd" android:minHeight="48dp" />
                        <com.google.android.material.button.MaterialButton android:maxLines="6" android:id="@+id/data_deletion_button" style="@style/Widget.LocalSignage.TopicButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="start|center_vertical" android:text="@string/legal_data_deletion_title" app:cornerRadius="@dimen/ui_corner_radius" app:icon="@drawable/ic_chevron_right_24" app:iconGravity="textEnd" android:minHeight="48dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/analytics_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:minHeight="48dp" android:text="@string/legal_analytics_title" android:textColor="@color/billing_text_primary" android:textSize="@dimen/ui_text_body" />
                        <TextView android:id="@+id/analytics_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/legal_analytics_summary" android:textColor="@color/billing_text_secondary" android:textSize="@dimen/ui_text_body" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>